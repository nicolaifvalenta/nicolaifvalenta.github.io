---
layout: base.njk
title: "stuff I've read"
permalink: /reading/index.html
search: true
---
<h2 class="page-title">stuff I've read</h2>
<p class="lede">{{ collections.books.length }} {{ "book/paper" if collections.books.length == 1 else "books/papers" }} so far. My short summary under each, detailed notes if you tap on them.</p>

{% if collections.books.length %}
<div class="booksearch" id="booksearch" hidden>
  <input type="search" id="q" placeholder="Search" aria-label="Search my reading" autocomplete="off">
</div>

<ul class="books" id="books">
{%- for b in collections.books %}
  <li class="book" data-s="{{ b.data.title }} {{ b.data.author }}">
    <div class="cover">
      {%- if b.fileSlug | hasCover %}<img src="/img/covers/{{ b.fileSlug }}.jpg" alt="" loading="lazy">
      {%- else %}<span class="nocover"><span>{{ b.data.title }}</span></span>{% endif %}
    </div>
    <div class="info">
      <h3><a href="{{ b.url }}"><em>{{ b.data.title }}</em></a></h3>
      <p class="byline">{{ b.data.author }}{% if b.data.rating %}<span class="rating"> · {{ b.data.rating }}/10</span>{% endif %}</p>
      {%- if b.templateContent | summaryOf %}<p class="summary">{{ b.templateContent | summaryOf | safe }}</p>{% endif %}
    </div>
  </li>
{%- endfor %}
</ul>
<p class="none" id="none" hidden>Nothing matches that.</p>
{% else %}
<p class="none">Nothing here yet.</p>
{% endif %}

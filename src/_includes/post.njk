---
layout: base.njk
---
<article class="post">
  <header class="post-head">
    <h1>{{ title }}</h1>
    <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time>{% if revised %} · revised {{ revised | longDate }}{% endif %}</p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <hr class="fleuron" aria-hidden="true">
</article>

{#- Two quiet columns of paintings in the margins; the second runs two pieces ahead. Public-domain images, Art Institute of Chicago. -#}
{% for side in ["left", "right"] %}
{% set pieces = paintings | rotate(2 if side == "right" else 0) %}
<aside class="art art-{{ side }}" aria-hidden="true">
  {%- for p in pieces %}
  <figure class="slide{% if loop.first %} on{% endif %}" style="--pos: {{ p.pos }}">
    <div class="frame"><img {% if loop.first %}src="/img/art/{{ p.file }}.jpg"{% else %}data-src="/img/art/{{ p.file }}.jpg"{% endif %} alt=""></div>
    <figcaption>{{ p.artist }}, <em>{{ p.title }}</em>, {{ p.year }}</figcaption>
  </figure>
  {%- endfor %}
</aside>
{% endfor %}

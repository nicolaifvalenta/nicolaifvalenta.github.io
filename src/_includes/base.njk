<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="color-scheme" content="light">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
  <link rel="preload" href="/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css?v={{ build.id }}">
  {% if math %}<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.19.1/dist/katex.min.css">{% endif %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {% if art %}{% include "art.njk" %}{% endif %}
  <div class="page">
    <header class="masthead">
      <h1 class="name"><a href="/">{{ site.name }}</a></h1>
      <nav aria-label="Primary">
        <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>about</a><span class="bar" aria-hidden="true">|</span><a href="/writing/"{% if page.url == "/writing/" or tags and "posts" in tags %} aria-current="page"{% endif %}>writing</a>
      </nav>
    </header>
    <hr class="rule">

    <main id="main">
      {{ content | safe }}
    </main>

    <footer class="colophon-line">
      <hr class="fleuron" aria-hidden="true">
      <p><a href="/feed.xml">feed</a> · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </footer>
  </div>
  <script src="/js/site.js?v={{ build.id }}"></script>
  {% if art %}<script src="/js/art.js?v={{ build.id }}"></script>{% endif %}
</body>
</html>
